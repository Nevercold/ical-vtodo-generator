{
  "name": "ical-vtodo-generator",
  "version": "0.0.0",
  "description": "Generate VTODO components (RFC 5545) for calendars built with ical-generator",
  "keywords": [
    "ical",
    "icalendar",
    "ics",
    "vtodo",
    "todo",
    "rfc5545",
    "ical-generator"
  ],
  "license": "MIT",
  "author": "Moritz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nevercold/ical-vtodo-generator.git"
  },
  "bugs": {
    "url": "https://github.com/Nevercold/ical-vtodo-generator/issues"
  },
  "homepage": "https://github.com/Nevercold/ical-vtodo-generator#readme",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "ical-generator": "11.1.3",
    "ical.js": "2.2.1",
    "tsdown": "0.23.7",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
